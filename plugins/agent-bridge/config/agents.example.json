{
  "version": 1,
  "defaults": {
    "max_concurrent_tasks": 4,
    "max_retained_tasks": 100,
    "default_timeout_sec": 3600,
    "max_timeout_sec": 86400,
    "default_max_output_bytes": 2097152,
    "allowed_work_roots": []
  },
  "agents": {
    "claude": {
      "enabled": true,
      "description": "Claude Code in non-interactive print mode",
      "command": [
        "claude",
        "-p",
        "--output-format",
        "text",
        "{prompt}"
      ],
      "prompt_mode": "argument",
      "inherit_env": true,
      "allow_extra_args": true
    },
    "antigravity": {
      "enabled": false,
      "description": "Template alias; update the command for the installed Antigravity CLI version before enabling",
      "command": [
        "antigravity",
        "{prompt}"
      ],
      "prompt_mode": "argument",
      "inherit_env": true,
      "allow_extra_args": true
    }
  }
}
