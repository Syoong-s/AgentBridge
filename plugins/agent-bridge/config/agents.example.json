{
  "version": 1,
  "defaults": {
    "max_concurrent_tasks": 4,
    "max_retained_tasks": 100,
    "default_timeout_sec": 3600,
    "max_timeout_sec": 86400,
    "default_max_output_bytes": 2097152,
    "allowed_work_roots": []
  },
  "agents": {
    "claude": {
      "enabled": true,
      "description": "Claude Code in non-interactive print mode",
      "command": [
        "claude",
        "-p",
        "--output-format",
        "text",
        "{prompt}"
      ],
      "prompt_mode": "argument",
      "inherit_env": true,
      "allow_extra_args": true,
      "model": {
        "arguments": [
          "--model",
          "{model}"
        ]
      },
      "reasoning_effort": {
        "arguments": [
          "--effort",
          "{reasoning_effort}"
        ],
        "allowed_values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultracode"
        ]
      },
      "session": {
        "id_source": "generated_uuid",
        "start_arguments": [
          "--session-id",
          "{session_id}"
        ],
        "resume_arguments": [
          "--resume",
          "{session_id}"
        ]
      }
    },
    "antigravity": {
      "enabled": true,
      "description": "Google Antigravity CLI in headless JSON mode (official executable: agy)",
      "command": [
        "agy",
        "--output-format",
        "json",
        "-p={prompt}"
      ],
      "prompt_mode": "argument",
      "inherit_env": true,
      "allow_extra_args": true,
      "model": {
        "arguments": [
          "--model",
          "{model}"
        ]
      },
      "reasoning_effort": {
        "arguments": [
          "--effort",
          "{reasoning_effort}"
        ],
        "allowed_values": [
          "low",
          "medium",
          "high"
        ]
      },
      "session": {
        "id_source": "stdout_json",
        "resume_arguments": [
          "--conversation",
          "{session_id}"
        ],
        "id_json_path": [
          "conversation_id"
        ]
      }
    }
  }
}
